<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>de.sfl</groupId>
	<!-- TODO replace me -->
	<artifactId>open-code-spring-boot-evaluation</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>OpenCode Spring Boot Evaluation</name>
	<description>Simple Spring Boot Application to evaluate OpenCode</description>

	<properties>
		<java.version>21</java.version>

		<applicationName>${project.artifactId}</applicationName>

		<docker.appUser>application_user</docker.appUser>
		<docker.baseImage>library/eclipse-temurin:21-jre-jammy</docker.baseImage>
		<docker.filter />
		<docker.hostName>localhost</docker.hostName>
		<docker.image>${applicationName}</docker.image>
		<docker.workdir>/opt/application</docker.workdir>

		<deployAtEnd>false</deployAtEnd>

		<postgres.port>5432</postgres.port>
		<postgres.database>testdb</postgres.database>
		<postgres.user>testuser</postgres.user>
		<postgres.password>testpass</postgres.password>

		<skipTests>false</skipTests>

		<!--dependency
		versions-->
		<springdoc-openapi-starter-webmvc-ui.version>2.8.15</springdoc-openapi-starter-webmvc-ui.version>

		<!-- plugin versions -->
		<docker-maven-plugin.version>0.48.1</docker-maven-plugin.version>
		<testcontainers.version>2.0.3</testcontainers.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc-openapi-starter-webmvc-ui.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.34</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<configuration>
					<skip>${skipTests}</skip>
					<deployAtEnd>${deployAtEnd}</deployAtEnd>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<docker.hostName>${docker.hostName}</docker.hostName>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>io.fabric8</groupId>
				<artifactId>docker-maven-plugin</artifactId>
				<version>${docker-maven-plugin.version}</version>
				<configuration>
					<containerNamePattern>%a-%i</containerNamePattern>
					<registry>${docker.registry}</registry>

					<filter>${docker.filter}</filter>
					<skipRun>${skipTests}</skipRun>

					<autoCreateCustomNetworks>true</autoCreateCustomNetworks>
					<logDate>ISO8601</logDate>
					<startParallel>true</startParallel>
					<removeVolumes>true</removeVolumes>

					<images>
						<!-- Application image -->
						<image>
							<name>${docker.image}</name>
							<alias>${applicationName}</alias>
							<build>
								<from>${docker.baseImage}</from>
								<cacheFrom>${docker.image}:latest</cacheFrom>
								<tags>
									<tag>latest</tag>
									<tag>${project.version}</tag>
								</tags>
								<user>${docker.appUser}</user>
								<workdir>${docker.workdir}</workdir>
								<assembly>
									<inline>
										<files>
											<file>
												<source>
													${project.build.directory}/${project.build.finalName}.jar
												</source>
											</file>
										</files>
									</inline>
									<targetDir>${docker.workdir}</targetDir>
								</assembly>
								<entryPoint>
									<exec>
										<arg>java</arg>
										<arg>
											-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
                                        </arg>
										<arg>-jar</arg>
										<arg>
											${docker.workdir}/${project.build.finalName}.jar
										</arg>
									</exec>
								</entryPoint>
								<runCmds>
									<run>groupadd --system ${docker.appUser}</run>
									<run>useradd --system --gid ${docker.appUser} ${docker.appUser}</run>
								</runCmds>
							</build>
							<run>
								<network>
									<mode>custom</mode>
									<name>integration-test-network</name>
								</network>
								<links>
									<link>postgres:postgres</link>
								</links>
								<env>
									<SPRING_DATASOURCE_URL>
										jdbc:postgresql://postgres:${postgres.port}/${postgres.database}</SPRING_DATASOURCE_URL>
									<SPRING_DATASOURCE_USERNAME>${postgres.user}</SPRING_DATASOURCE_USERNAME>
									<SPRING_DATASOURCE_PASSWORD>${postgres.password}</SPRING_DATASOURCE_PASSWORD>
								</env>
								<ports>
									<port>8080:8080</port>
									<port>5005:5005</port>
								</ports>
								<wait>
									<http>
										<url>http://${docker.hostName}:8080/actuator/health</url>
										<method>GET</method>
										<status>200</status>
									</http>
									<time>120000</time>
								</wait>
								<log>
									<enabled>true</enabled>
									<file>
										${project.build.directory}/${applicationName}-container.log</file>
								</log>
							</run>
						</image>

						<!-- PostgreSQL for integration tests -->
						<image>
							<name>postgres:17-alpine</name>
							<alias>postgres</alias>
							<run>
								<network>
									<mode>custom</mode>
									<name>integration-test-network</name>
									<alias>postgres</alias>
								</network>
								<env>
									<POSTGRES_DB>${postgres.database}</POSTGRES_DB>
									<POSTGRES_USER>${postgres.user}</POSTGRES_USER>
									<POSTGRES_PASSWORD>${postgres.password}</POSTGRES_PASSWORD>
								</env>
								<ports>
									<port>${postgres.port}:5432</port>
								</ports>
								<wait>
									<log>database system is ready to accept connections</log>
									<time>60000</time>
								</wait>
								<log>
									<enabled>true</enabled>
									<file>${project.build.directory}/postgres-container.log</file>
								</log>
							</run>
						</image>
					</images>
				</configuration>
				<executions>
					<execution>
						<id>docker-build</id>
						<phase>package</phase>
						<goals>
							<goal>build</goal>
						</goals>
						<configuration>
							<filter>${docker.image}</filter>
						</configuration>
					</execution>
					<execution>
						<id>docker-push</id>
						<phase>deploy</phase>
						<goals>
							<goal>push</goal>
						</goals>
						<configuration>
							<filter>${docker.image}</filter>
						</configuration>
					</execution>
					<execution>
						<id>docker-start</id>
						<phase>none</phase>
						<goals>
							<goal>start</goal>
						</goals>
					</execution>
					<execution>
						<id>docker-stop</id>
						<phase>none</phase>
						<goals>
							<goal>stop</goal>
						</goals>
					</execution>
					<execution>
						<id>start-containers</id>
						<phase>pre-integration-test</phase>
						<goals>
							<goal>start</goal>
						</goals>
						<configuration>
							<filter>postgres,${applicationName}</filter>
						</configuration>
					</execution>
					<execution>
						<id>stop-containers</id>
						<phase>post-integration-test</phase>
						<goals>
							<goal>stop</goal>
						</goals>
						<configuration>
							<filter>postgres,${applicationName}</filter>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>ci</id>
			<properties>
				<docker.host>https://docker:2376</docker.host>
				<docker.hostName>docker</docker.hostName>
				<deployAtEnd>true</deployAtEnd>
			</properties>
		</profile>
	</profiles>
</project>