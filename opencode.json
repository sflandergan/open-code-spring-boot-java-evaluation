{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "rm *": "ask",

      "cat *": "allow",
      "diff *": "allow",
      "find *": "allow",

      "git show *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git grep *": "allow",
      "git stash *": "allow",
      "git checkout *": "allow",
      "git status *": "allow",
      "git commit *": "allow",

      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",    
      "mvn *": "allow",
      "sort *": "allow",
      "tail": "allow",
      "xargs *": "allow",
      "xmllint *": "allow",
      "wc *": "allow"
    },
    "edit": "allow",
    "webfetch": "ask"
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (Local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "lmstudio/qwen/qwen3-coder-30": {
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "lmstudio/Qwen3.5-27B-4bit": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/mistralai/devstral-small-2-2512": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/NVIDIA-Nemotron-3-Nano-30B-A3B-MLX-4bit": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/gpt-oss-safeguard-20b-MLX-MXFP4": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/google/gemma-3-27b": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "lmstudio/qwen/qwen3-coder-30"
}