{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "rm *": "ask",

      "cat *": "allow",
      "diff *": "allow",
      "find *": "allow",
      "pwd": "allow",

      "date *": "allow",

      "git show *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git grep *": "allow",
      "git stash *": "allow",
      "git checkout *": "allow",
      "git status *": "allow",
      "git commit *": "allow",

      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",    
      "mvn *": "allow",
      "sort *": "allow",
      "tail": "allow",
      "xargs *": "allow",
      "xmllint *": "allow",
      "wc *": "allow"
    },
    "edit": "allow",
    "webfetch": "ask"
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (Local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "lmstudio/qwen/qwen3-coder-30": {
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "lmstudio/Qwen3.5-27B-4bit": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/Qwen3.5-9B-MLX-4bit": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/mistralai/devstral-small-2-2512": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/NVIDIA-Nemotron-3-Nano-30B-A3B-MLX-4bit": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/gpt-oss-safeguard-20b-MLX-MXFP4": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "lmstudio/google/gemma-3-27b": {
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    },
    "requesty": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Requesty",
      "options": {
        "baseURL": "https://router.requesty.ai/v1"
      },
      "models": {
        "google/gemini-3.1-flash-lite-preview": {
          "limit": {
            "context": 1000000,
            "output": 66000
          }
        },
        "minimaxi/MiniMax-M2.5": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "nebius/moonshotai/kimi-k2.5": {
          "limit": {
            "context": 256000,
            "output": 128000
          }
        },
        "mistral/devstral-latest": {
          "limit": {
            "context": 256000,
            "output": 32000
          }
        },
        "nebius/zai-org/GLM-4.7": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "nebius/deepseek-ai/DeepSeek-V3.2": {
          "limit": {
            "context": 164000,
            "output": 128000
          }
        },
        "alibaba/qwen-turbo": {
          "limit": {
            "context": 256000,
            "output": 66000
          }
        },
        "alibaba/qwen3.5": {
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  },
  "model": "lmstudio/qwen/qwen3-coder-30",
  "small_model": "github-copilot/gpt-5-mini"
}